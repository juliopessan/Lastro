DEEPSEEK_API_KEY=
AI_MODEL=deepseek-flash

# Acesso ao painel /admin
ADMIN_PASSWORD=
SESSION_SECRET=

# Envio da proposta por e-mail (Resend — resend.com)
RESEND_API_KEY=
# Opcional: remetente verificado. Sem domínio verificado no Resend, só é
# possível enviar para o e-mail da sua própria conta Resend.
EMAIL_FROM=
# Opcional: recebe um aviso por e-mail sempre que um cliente assina uma
# proposta. Sem essa variável, a notificação simplesmente não é enviada.
ADMIN_EMAIL=
# Opcional: caminho do executável do Chrome, usado para gerar o PDF anexado.
# Padrão assume macOS; em Linux normalmente é algo como
# /usr/bin/google-chrome ou /usr/bin/chromium.
CHROME_EXECUTABLE_PATH=
# Opcional: pasta onde o SQLite é criado. Padrão ./data — em produção,
# aponte para um volume persistente.
DATA_DIR=
# Endereço público do sistema, ex: https://propostas.seudominio.com (sem barra
# no fim). Em produção é obrigatório: é ele que vai no link "Revisar e assinar"
# do e-mail ao cliente. Sem ele o link sai do host da requisição, que atrás do
# proxy da hospedagem pode ser um endereço interno que o cliente não abre.
NEXT_PUBLIC_SITE_URL=
# Backup contínuo do banco (Litestream, só na imagem Docker). Sem estas
# variáveis o app funciona, mas o SQLite vive apenas no volume: perder o disco
# é perder as propostas. Exemplos de URL em docker/litestream.yml.
LITESTREAM_REPLICA_URL=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
